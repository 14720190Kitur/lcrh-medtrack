
workflows:
  default-workflow:
    name: LCRH MedTrack
    instance_type: mac_mini_m1
    environment:
      flutter: stable
    scripts:
      - name: Create Android folder
        script: |
          flutter create . --platforms=android --project-name lcrh_medtrack
      - name: Get packages
        script: flutter pub get
      - name: Build APK
        script: flutter build apk --release
    artifacts:
      - build/app/outputs/**/*.apk
